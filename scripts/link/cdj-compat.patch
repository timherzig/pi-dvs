new file mode 100644
index 0000000..b9f111c
--- /dev/null
+++ b/crates/rbl-nfs/src/pacing.rs
@@ -0,0 +1,137 @@
+//! Bounded per-player pacing; socket I/O and waiting stay in `net`.
+use std::collections::HashMap;
+use std::net::Ipv4Addr;
+use std::time::{Duration, Instant};
+
+/// Preserve the original budget for files without a format-aware hint.
+pub(crate) const DEFAULT_READ_RATE: std::num::NonZeroU64 =
+    std::num::NonZeroU64::new(512 * 1024).unwrap();
+const MAX_PEERS: usize = 16;
+
+#[derive(Default)]
+pub(crate) struct ReadPacer {
+    next: HashMap<Ipv4Addr, Instant>,
+    overflow: Option<Instant>,
+}
+impl ReadPacer {
+    pub(crate) fn ready_at(&self, peer: Ipv4Addr, now: Instant) -> Instant {
+        self.next
+            .get(&peer)
+            .copied()
+            .or(self.overflow)
+            .unwrap_or(now)
+            .max(now)
+    }
+
+    /// Called only after a successful send. Retransmitted replies cost bytes too.
+    pub(crate) fn sent(&mut self, peer: Ipv4Addr, bytes: usize, rate: std::num::NonZeroU64, completed: Instant) {
+        self.next.retain(|_, deadline| *deadline > completed);
+        let nanos = (bytes as u64 * 1_000_000_000).div_ceil(rate.get());
+        let next = completed + Duration::from_nanos(nanos);
+        if self.next.len() < MAX_PEERS || self.next.contains_key(&peer) {
+            self.next.insert(peer, next);
+        } else {
+            // Excess peers share a bounded fallback budget; none bypass pacing.
+            self.overflow = Some(next);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn peer(n: u8) -> Ipv4Addr {
+        Ipv4Addr::new(192, 0, 2, n)
+    }
+    #[test]
+    fn independent_players_get_full_budgets_without_idle_bursts() {
+        let mut pacer = ReadPacer::default();
+        let start = Instant::now();
+        let interval = Duration::from_nanos(18_135_071);
+        pacer.sent(peer(1), 9508, DEFAULT_READ_RATE, start);
+        assert_eq!(pacer.ready_at(peer(1), start), start + interval);
+        assert_eq!(pacer.ready_at(peer(2), start), start);
+        pacer.sent(peer(2), 9508, DEFAULT_READ_RATE, start);
+        assert_eq!(pacer.ready_at(peer(2), start), start + interval);
+        let idle = start + Duration::from_secs(60);
+        assert_eq!(pacer.ready_at(peer(1), idle), idle);
+        pacer.sent(peer(1), 9508, DEFAULT_READ_RATE, idle);
+        assert_eq!(pacer.ready_at(peer(1), idle), idle + interval);
+    }
+    #[test]
+    fn late_sends_and_cached_replies_use_actual_completion_time() {
+        let mut pacer = ReadPacer::default();
+        let start = Instant::now();
+        let completed = start + Duration::from_millis(100);
+        pacer.sent(peer(1), 524288, DEFAULT_READ_RATE, completed);
+        assert_eq!(
+            pacer.ready_at(peer(1), completed),
+            completed + Duration::from_secs(1)
+        );
+        let retry = completed + Duration::from_secs(1);
+        pacer.sent(peer(1), 524288, DEFAULT_READ_RATE, retry);
+        assert_eq!(
+            pacer.ready_at(peer(1), retry),
+            retry + Duration::from_secs(1)
+        );
+    }
+    #[test]
+    fn excess_peers_share_a_budget_and_expired_entries_are_reclaimed() {
+        let mut pacer = ReadPacer::default();
+        let start = Instant::now();
+        for n in 1..=16 {
+            pacer.sent(peer(n), 524288, DEFAULT_READ_RATE, start);
+        }
+        pacer.sent(peer(17), 524288, DEFAULT_READ_RATE, start);
+        assert_eq!(
+            pacer.ready_at(peer(18), start),
+            start + Duration::from_secs(1)
+        );
+        assert_eq!(pacer.next.len(), MAX_PEERS);
+        let later = start + Duration::from_secs(2);
+        pacer.sent(peer(18), 9508, DEFAULT_READ_RATE, later);
+        assert_eq!(pacer.next.len(), 1);
+        assert_eq!(pacer.ready_at(peer(19), later), later);
+    }
+    #[test]
+    fn freeing_a_tracked_slot_does_not_erase_an_overflow_budget() {
+        let mut pacer = ReadPacer::default();
+        let start = Instant::now();
+        for n in 1..=14 {
+            pacer.sent(peer(n), 524288, DEFAULT_READ_RATE, start);
+        }
+        for n in 15..=16 {
+            pacer.sent(peer(n), 1, DEFAULT_READ_RATE, start);
+        }
+        pacer.sent(peer(17), 65536, DEFAULT_READ_RATE, start);
+        let later = start + Duration::from_millis(20);
+        pacer.sent(peer(15), 1, DEFAULT_READ_RATE, later);
+        assert_eq!(pacer.next.len(), 15);
+        assert_eq!(
+            pacer.ready_at(peer(17), later),
+            start + Duration::from_millis(125)
+        );
+    }
+    #[test]
+    fn file_rate_changes_and_replays_preserve_each_players_existing_debt() {
+        let low = std::num::NonZeroU64::new(262_144).unwrap();
+        let high = std::num::NonZeroU64::new(403_200).unwrap();
+        let mut pacer = ReadPacer::default();
+        let start = Instant::now();
+        let low_gap = Duration::from_nanos(36_270_142);
+        let high_gap = Duration::from_nanos(23_581_350);
+        pacer.sent(peer(1), 9508, low, start);
+        pacer.sent(peer(2), 9508, high, start);
+        assert_eq!(pacer.ready_at(peer(1), start), start + low_gap);
+        assert_eq!(pacer.ready_at(peer(2), start), start + high_gap);
+        // Switching files cannot bypass the prior file's pending budget.
+        let switched = pacer.ready_at(peer(1), start);
+        pacer.sent(peer(1), 9508, high, switched);
+        assert_eq!(pacer.ready_at(peer(1), switched), switched + high_gap);
+        // A cached reply is charged in exactly the same way.
+        let replay = pacer.ready_at(peer(1), switched);
+        pacer.sent(peer(1), 9508, high, replay);
+        assert_eq!(pacer.ready_at(peer(1), replay), replay + high_gap);
+    }
+
+}
